<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mentoria Black — Dashboard Financeiro</title>
<style>
:root{--bg:#070707;--panel:#0d0d0d;--panel2:#111;--gold:#C9A227;--gold2:#e1c45a;--text:#f2f2f2;--muted:#9b9b9b;--line:#2a2a2a;--soft:#171717;--danger:#a77777;--ok:#9da889}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
body{min-height:100vh}.wrap{max-width:1500px;margin:auto;padding:26px}
header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;border-bottom:1px solid var(--line);padding-bottom:18px;margin-bottom:18px}
.brand small{letter-spacing:.22em;color:var(--gold);font-weight:700}.brand h1{margin:6px 0 0;font-size:27px;letter-spacing:.02em}.brand p{margin:5px 0 0;color:var(--muted);font-size:13px}
.actions{display:flex;gap:8px;flex-wrap:wrap}.btn,select{background:#0e0e0e;color:var(--text);border:1px solid #333;border-radius:8px;padding:9px 12px;font:inherit}.btn{cursor:pointer}.btn:hover{border-color:var(--gold);color:var(--gold)}
.filters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:18px}.filter{background:var(--panel);border:1px solid var(--line);padding:11px;border-radius:10px}.filter label{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px}.filter select{width:100%;padding:8px}
.check{display:flex;align-items:center;gap:8px;height:38px;color:var(--muted);font-size:13px}.check input{accent-color:var(--gold)}
.tabs{display:flex;gap:5px;border-bottom:1px solid var(--line);margin-bottom:18px}.tab{border:0;background:transparent;color:var(--muted);padding:10px 15px;cursor:pointer;border-bottom:2px solid transparent;font-weight:650}.tab.active{color:var(--gold);border-color:var(--gold)}
.grid-kpi{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:14px}.kpi{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px}.kpi .label{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.07em}.kpi .value{font-size:23px;font-weight:750;margin-top:7px}.kpi .sub{font-size:11px;color:var(--muted);margin-top:4px}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:12px;margin-bottom:12px}.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:15px;min-width:0}.span12{grid-column:span 12}.span8{grid-column:span 8}.span7{grid-column:span 7}.span6{grid-column:span 6}.span5{grid-column:span 5}.span4{grid-column:span 4}.span3{grid-column:span 3}.card h2{font-size:14px;margin:0 0 3px}.card .desc{font-size:11px;color:var(--muted);margin-bottom:10px}.chart{width:100%;min-height:300px}.chart svg{width:100%;height:300px;display:block}.chart.tall svg{height:360px}
.section-title{display:flex;justify-content:space-between;align-items:end;margin:22px 0 10px}.section-title h2{margin:0;font-size:16px}.section-title span{font-size:11px;color:var(--muted)}
table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:9px 7px;border-bottom:1px solid #222;text-align:right}th{color:var(--muted);font-weight:650}th:first-child,td:first-child{text-align:left}
.barlist{display:grid;gap:10px}.barrow{display:grid;grid-template-columns:150px 1fr 90px;align-items:center;gap:10px;font-size:12px}.track{height:9px;background:#1c1c1c;border-radius:99px;overflow:hidden}.fill{height:100%;background:var(--gold);border-radius:99px}
.heat{display:grid;grid-template-columns:130px repeat(12,1fr);gap:3px;font-size:10px}.heat div{padding:7px 3px;text-align:center;border:1px solid #191919}.heat .head{color:var(--muted);background:#0a0a0a}.heat .label{text-align:left;color:#ddd}.heat .cell{color:#eee}
.insights{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.insight{border-left:2px solid var(--gold);background:#101010;padding:10px 12px;font-size:12px;line-height:1.45}.insight b{color:var(--gold)}
.status{display:inline-block;padding:4px 7px;border:1px solid #3a3a3a;border-radius:99px;font-size:10px;color:var(--muted)}.gold{color:var(--gold)}
.note{color:var(--muted);font-size:11px;line-height:1.5}.empty{height:250px;display:grid;place-items:center;color:var(--muted);border:1px dashed #2a2a2a;border-radius:8px;text-align:center;padding:20px}
.progress{height:10px;background:#1c1c1c;border-radius:99px;overflow:hidden}.progress i{display:block;height:100%;background:var(--gold)}
footer{border-top:1px solid var(--line);padding:15px 0 5px;margin-top:18px;color:#777;font-size:10px}
@media(max-width:1100px){.grid-kpi{grid-template-columns:repeat(3,1fr)}.filters{grid-template-columns:repeat(2,1fr)}.span8,.span7,.span6,.span5,.span4,.span3{grid-column:span 12}.insights{grid-template-columns:1fr 1fr}}
@media(max-width:650px){.wrap{padding:15px}header{display:block}.actions{margin-top:12px}.grid-kpi{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:1fr}.barrow{grid-template-columns:105px 1fr 72px}.heat{grid-template-columns:90px repeat(12,1fr);font-size:8px}.insights{grid-template-columns:1fr}.kpi .value{font-size:18px}}
</style>

<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Mentoria Black">
<meta name="format-detection" content="telephone=no">
<meta name="theme-color" content="#070707">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  html { -webkit-text-size-adjust: 100%; }
  body { -webkit-tap-highlight-color: transparent; }
  button, select { min-height: 42px; }
  @media (max-width: 650px) {
    .wrap { padding-bottom: 28px; }
    .tabs { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .tab { flex: 0 0 auto; }
    .chart { overflow-x: auto; }
    table { min-width: 620px; }
  }

.auth-screen{min-height:100vh;display:grid;place-items:center;padding:24px;background:#070707}
.auth-card{width:min(430px,100%);background:#0d0d0d;border:1px solid #2a2a2a;border-radius:14px;padding:28px}
.auth-brand{color:#C9A227;letter-spacing:.22em;font-weight:800;font-size:12px}
.auth-card h1{margin:10px 0 6px;font-size:25px}.auth-card p{color:#9b9b9b;font-size:13px;line-height:1.5}
.auth-card label{display:block;color:#aaa;font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin:16px 0 6px}
.auth-card input{width:100%;background:#080808;color:#f2f2f2;border:1px solid #333;border-radius:8px;padding:12px;font:inherit}
.auth-main-btn{width:100%;margin-top:18px;background:#C9A227;color:#070707;border:0;border-radius:8px;padding:12px;font-weight:800}
.auth-secondary{background:transparent;color:#aaa;border:0;width:100%;margin-top:12px;padding:8px}
.auth-msg{min-height:20px;margin-top:12px;font-size:12px;color:#aaa}.auth-msg.ok{color:#b8c78d}.auth-msg.err{color:#d8a0a0}
.userbar{display:flex;align-items:center;gap:8px;color:#999;font-size:11px}
.hidden{display:none!important}
</style>
</head>
<body>

<div id="authScreen" class="auth-screen">
  <div class="auth-card">
    <div class="auth-brand">MENTORIA BLACK</div>
    <h1>Dashboard Financeiro</h1>
    <p>Acesse sua conta para visualizar seus dados financeiros.</p>
    <form id="authForm">
      <label>E-mail</label>
      <input id="email" type="email" autocomplete="email" required placeholder="seu@email.com">
      <label>Senha</label>
      <input id="password" type="password" autocomplete="current-password" required minlength="6" placeholder="••••••••">
      <button class="auth-main-btn" type="submit">Entrar</button>
      <button class="auth-secondary" type="button" id="signupBtn">Criar minha conta</button>
      <button class="auth-secondary" type="button" id="resetBtn">Esqueci minha senha</button>
      <div id="authMsg" class="auth-msg"></div>
    </form>
  </div>
</div>

<div id="dashboardRoot" class="hidden">
<div class="wrap">
<header>
  <div class="brand">
    <small>MENTORIA BLACK</small>
    <h1>Dashboard Financeiro</h1>
    <p>Gestão, comportamento, planejamento e execução financeira em uma única visão.</p>
  </div>
  <div class="actions"><div class="userbar"><span id="userEmail"></span><button class="btn" id="logout">Sair</button></div>
    <button class="btn" id="print">Imprimir / PDF</button>
    <button class="btn" id="reset">Resetar filtros</button>
  </div>
</header>

<div class="filters">
  <div class="filter"><label>Período</label><select id="period"><option value="ANO">Ano completo</option></select></div>
  <div class="filter"><label>Categoria</label><select id="category"><option value="TODAS">Todas as categorias</option></select></div>
  <div class="filter"><label>Modo de análise</label><select id="mode"><option value="REALIZADO">Realizado</option><option value="PLANEJADO">Planejado</option><option value="DESVIO">Desvio</option></select></div>
  <div class="filter"><label>Exibição</label><div class="check"><input type="checkbox" id="hideEmpty"><label for="hideEmpty" style="margin:0;text-transform:none;letter-spacing:0">Ocultar meses sem dados</label></div></div>
</div>

<div class="tabs">
  <button class="tab active" data-tab="overview">Visão geral</button>
  <button class="tab" data-tab="behavior">Comportamento</button>
  <button class="tab" data-tab="annual">Visão anual</button>
</div>

<main id="app"></main>
<footer>Dados carregados do Supabase após o login. Nenhum dado financeiro fica incorporado neste HTML.</footer>
</div>

<script>
const SUPABASE_URL="https://mwjqfzbpjmwiscvtxvfc.supabase.co";
const SUPABASE_ANON_KEY="sb_publishable_Bz8zOgsayn5KRDKBa0_u_A_TbvV_RuK";
const {createClient}=supabase;
const sb=createClient(SUPABASE_URL,SUPABASE_ANON_KEY);
let DATA={months:[],launches:[],categories:["Gastos Fixos","Investimentos","Conforto","Metas","Lazer","Conhecimento"],source:"Supabase"};
const state={period:"ANO",category:"TODAS",mode:"REALIZADO",hideEmpty:false,tab:"overview"};
const $=id=>document.getElementById(id);
const cats=DATA.categories;
const months=DATA.months;
const money=v=>new Intl.NumberFormat("pt-BR",{style:"currency",currency:"BRL",maximumFractionDigits:2}).format(v||0);
const pct=v=>(v||0).toLocaleString("pt-BR",{minimumFractionDigits:1,maximumFractionDigits:1})+"%";
const n=v=>new Intl.NumberFormat("pt-BR",{maximumFractionDigits:0}).format(v||0);
function esc(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));}
function activeMonths(){
  let a=months;
  if(state.period!=="ANO") a=[state.period];
  if(state.hideEmpty) a=a.filter(m=>{let x=months.find(z=>z.month===m);return x.revenue>0 || Object.values(x.actual).some(v=>v>0) || Object.values(x.planned).some(v=>v>0)});
  return a;
}
function monthObj(m){return months.find(x=>x.month===m)}
function catVal(obj,kind,cat){
  if(state.category==="TODAS") return Object.values(obj[kind]).reduce((a,b)=>a+b,0);
  return obj[kind][state.category]||0;
}
function selectedTotals(){
  const ms=activeMonths(); let rev=0,plan=0,real=0;
  ms.forEach(m=>{let x=monthObj(m);rev+=x.revenue;plan+=catVal(x,"planned",state.category);real+=catVal(x,"actual",state.category)});
  return {rev,plan,real,saldo:rev-real};
}
function svgWrap(inner,label){return `<svg viewBox="0 0 900 320" role="img" aria-label="${esc(label)}" preserveAspectRatio="none">${inner}</svg>`}
function escNum(v){return Number.isFinite(v)?v:0}
function lineChart(series, labels, title){
  const W=900,H=320,L=55,R=18,T=22,B=42,iw=W-L-R,ih=H-T-B;
  const vals=series.flatMap(s=>s.values).map(escNum);let max=Math.max(...vals,1),min=Math.min(0,...vals);
  const x=i=>L+(labels.length<=1?iw/2:iw*i/(labels.length-1)), y=v=>T+(max-v)/(max-min||1)*ih;
  let g=`<g fill="none" stroke="#252525" stroke-width="1">`;
  for(let i=0;i<=4;i++){let yy=T+ih*i/4;g+=`<line x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}"/>`;}g+=`</g>`;
  g+=`<line x1="${L}" y1="${T}" x2="${L}" y2="${T+ih}" stroke="#444"/><line x1="${L}" y1="${T+ih}" x2="${W-R}" y2="${T+ih}" stroke="#444"/>`;
  labels.forEach((lab,i)=>g+=`<text x="${x(i)}" y="${H-15}" fill="#999" font-size="10" text-anchor="middle">${esc(lab)}</text>`);
  series.forEach((s,si)=>{
    const pts=s.values.map((v,i)=>`${x(i)},${y(v)}`).join(" ");
    g+=`<polyline points="${pts}" fill="none" stroke="${si===0?'#C9A227':'#8c8c8c'}" stroke-width="${si===0?3:2}"/>`;
    s.values.forEach((v,i)=>g+=`<circle cx="${x(i)}" cy="${y(v)}" r="3.5" fill="${si===0?'#C9A227':'#8c8c8c'}"><title>${esc(s.label)} — ${esc(labels[i])}: ${money(v)}</title></circle>`);
  });
  return svgWrap(g,title);
}
function barChart(labels,values,title,second=[]){
  const W=900,H=340,L=150,R=30,T=25,B=30,iw=W-L-R,ih=H-T-B;
  const max=Math.max(...values,...second,1), rows=labels.length, gap=ih/rows;
  let g=`<line x1="${L}" y1="${T}" x2="${L}" y2="${T+ih}" stroke="#444"/>`;
  labels.forEach((lab,i)=>{
    let y=T+i*gap+gap*.18,h=gap*.64;
    g+=`<text x="${L-8}" y="${y+h*.68}" fill="#ddd" font-size="11" text-anchor="end">${esc(lab)}</text>`;
    let w=iw*(values[i]||0)/max;
    g+=`<rect x="${L}" y="${y}" width="${w}" height="${h}" rx="4" fill="#C9A227"><title>${esc(lab)}: ${money(values[i])}</title></rect>`;
    if(second.length){let w2=iw*(second[i]||0)/max;g+=`<rect x="${L}" y="${y+h*.5}" width="${w2}" height="${h*.38}" rx="3" fill="#777"><title>Comparação: ${money(second[i])}</title></rect>`}
    g+=`<text x="${L+Math.max(w,2)+6}" y="${y+h*.68}" fill="#aaa" font-size="10">${money(values[i])}</text>`;
  });
  return `<svg viewBox="0 0 900 340" role="img" aria-label="${esc(title)}">${g}</svg>`;
}
function donut(values,labels,title){
  const total=values.reduce((a,b)=>a+b,0); if(!total)return `<div class="empty">Sem valores para esta seleção.</div>`;
  const cx=450,cy=155,r=92,ir=55;let a=-Math.PI/2,g="";
  const colors=["#C9A227","#777","#9d9d9d","#5c5c5c","#b8b8b8","#3b3b3b"];
  values.forEach((v,i)=>{if(v<=0)return;let da=v/total*Math.PI*2,a2=a+da;let x1=cx+r*Math.cos(a),y1=cy+r*Math.sin(a),x2=cx+r*Math.cos(a2),y2=cy+r*Math.sin(a2),ix1=cx+ir*Math.cos(a),iy1=cy+ir*Math.sin(a),ix2=cx+ir*Math.cos(a2),iy2=cy+ir*Math.sin(a2);let large=da>Math.PI?1:0;g+=`<path d="M ${x1} ${y1} A ${r} ${r} 0 ${large} 1 ${x2} ${y2} L ${ix2} ${iy2} A ${ir} ${ir} 0 ${large} 0 ${ix1} ${iy1} Z" fill="${colors[i%colors.length]}"><title>${esc(labels[i])}: ${money(v)} (${pct(v/total*100)})</title></path>`;a=a2;});
  g+=`<circle cx="${cx}" cy="${cy}" r="${ir-2}" fill="#0d0d0d"/><text x="${cx}" y="${cy-3}" text-anchor="middle" fill="#fff" font-size="16" font-weight="700">${money(total)}</text><text x="${cx}" y="${cy+17}" text-anchor="middle" fill="#999" font-size="10">TOTAL</text>`;
  labels.forEach((l,i)=>{let yy=45+i*25;g+=`<rect x="675" y="${yy-8}" width="9" height="9" fill="${colors[i%colors.length]}"/><text x="690" y="${yy}" fill="#bbb" font-size="11">${esc(l)}</text>`});
  return svgWrap(g,title);
}
function kpi(label,value,sub){return `<div class="kpi"><div class="label">${esc(label)}</div><div class="value">${value}</div><div class="sub">${sub||""}</div></div>`}
function totalsByCat(kind,ms){
  return cats.map(c=>ms.reduce((a,m)=>a+(monthObj(m)[kind][c]||0),0));
}
function concentration(ms){
  const vals=totalsByCat("actual",ms).sort((a,b)=>b-a);const total=vals.reduce((a,b)=>a+b,0);return total?((vals[0]+(vals[1]||0))/total*100):0;
}
function health(ms){
  const rev=ms.reduce((a,m)=>a+monthObj(m).revenue,0);
  const plan=ms.reduce((a,m)=>a+Object.values(monthObj(m).planned).reduce((x,y)=>x+y,0),0);
  const real=ms.reduce((a,m)=>a+Object.values(monthObj(m).actual).reduce((x,y)=>x+y,0),0);
  const invest=ms.reduce((a,m)=>a+monthObj(m).actual["Investimentos"],0);
  const fixed=ms.reduce((a,m)=>a+monthObj(m).actual["Gastos Fixos"],0);
  if(!rev)return 0;
  const margin=Math.max(0,Math.min(1,(rev-real)/rev));
  const inv=Math.max(0,Math.min(1,invest/rev));
  const fixedScore=Math.max(0,Math.min(1,1-fixed/rev));
  const adherence=plan?Math.max(0,Math.min(1,1-Math.abs(real-plan)/plan)):1;
  const spendControl=Math.max(0,Math.min(1,1-real/rev));
  return Math.round((margin*.25+inv*.2+fixedScore*.2+adherence*.2+spendControl*.15)*100);
}
function insights(ms){
  const t=selectedTotals();let out=[];
  if(!t.rev && !t.real){out.push("A base selecionada ainda não possui dados financeiros suficientes para conclusões.");return out}
  const catsVals=cats.map(c=>({c,v:ms.reduce((a,m)=>a+monthObj(m).actual[c],0)})).sort((a,b)=>b.v-a.v);
  if(catsVals[0].v)out.push(`<b>${catsVals[0].c}</b> é a categoria com maior gasto realizado: ${money(catsVals[0].v)}.`);
  if(t.rev)out.push(`A margem financeira da seleção é de <b>${pct(t.saldo/t.rev*100)}</b>, após ${money(t.real)} de gastos.`);
  const conc=concentration(ms); if(conc)out.push(`As duas maiores categorias concentram <b>${pct(conc)}</b> dos gastos realizados.`);
  const plan=ms.reduce((a,m)=>a+Object.values(monthObj(m).planned).reduce((x,y)=>x+y,0),0);
  if(plan)out.push(`A execução está em <b>${pct(t.real/plan*100)}</b> do valor planejado.`);
  const inv=ms.reduce((a,m)=>a+monthObj(m).actual["Investimentos"],0);
  if(t.rev)out.push(`A taxa de investimento realizada é de <b>${pct(inv/t.rev*100)}</b>.`);
  return out.slice(0,6);
}
function overview(){
  const ms=activeMonths(),t=selectedTotals(),real=t.real,plan=t.plan;
  const healthScore=health(ms), inv=ms.reduce((a,m)=>a+monthObj(m).actual.Investimentos,0),fixed=ms.reduce((a,m)=>a+monthObj(m).actual["Gastos Fixos"],0);
  const count=DATA.launches.filter(x=>(state.period==="ANO"||x.month===state.period)&&(state.category==="TODAS"||x.category===state.category)).length;
  const avg=count?real/count:0;
  const lineLabels=ms, revs=ms.map(m=>monthObj(m).revenue), exps=ms.map(m=>catVal(monthObj(m),"actual",state.category));
  const catVals=totalsByCat("actual",ms), planVals=totalsByCat("planned",ms);
  const categoryLabels=cats;
  const ins=insights(ms).map(x=>`<div class="insight">${x}</div>`).join("");
  return `
  <div class="grid-kpi">
    ${kpi("Receita",money(t.rev),"Receita dos períodos filtrados")}
    ${kpi("Gastos realizados",money(real),t.rev?pct(real/t.rev*100)+" da receita":"Sem receita")}
    ${kpi("Saldo",money(t.saldo),t.rev?pct(t.saldo/t.rev*100)+" de margem":"")}
    ${kpi("Investimentos",money(inv),t.rev?pct(inv/t.rev*100)+" da receita":"")}
    ${kpi("Gastos fixos",money(fixed),t.rev?pct(fixed/t.rev*100)+" da receita":"")}
    ${kpi("Saúde financeira",healthScore+"/100",healthScore>=70?"Boa aderência":"Atenção")}
  </div>
  <div class="grid">
    <section class="card span7"><h2>Receita × gastos</h2><div class="desc">Evolução mensal conforme os filtros selecionados.</div><div class="chart">${lineChart([{label:"Receita",values:revs},{label:"Gastos",values:exps}],lineLabels,"Receita versus gastos")}</div></section>
    <section class="card span5"><h2>Distribuição dos gastos</h2><div class="desc">Composição do gasto realizado.</div><div class="chart">${donut(catVals,categoryLabels,"Distribuição dos gastos")}</div></section>
    <section class="card span6"><h2>Planejado × realizado</h2><div class="desc">A barra dourada representa o realizado; a cinza, o planejado.</div><div class="chart tall">${barChart(categoryLabels,catVals,"Planejado versus realizado",planVals)}</div></section>
    <section class="card span6"><h2>Saldo mensal</h2><div class="desc">Receita menos gastos realizados.</div><div class="chart">${lineChart([{label:"Saldo",values:ms.map(m=>monthObj(m).revenue-catVal(monthObj(m),"actual",state.category))}],lineLabels,"Saldo mensal")}</div></section>
    <section class="card span12"><h2>Leitura executiva</h2><div class="desc">Principais conclusões calculadas a partir da seleção atual.</div><div class="insights">${ins||'<div class="note">Sem dados suficientes.</div>'}</div></section>
    <section class="card span12"><h2>Indicadores de concentração</h2><div class="barlist">
      ${categoryLabels.map((c,i)=>{let v=catVals[i],mx=Math.max(...catVals,1);return `<div class="barrow"><span>${esc(c)}</span><div class="track"><div class="fill" style="width:${v/mx*100}%"></div></div><strong>${money(v)}</strong></div>`}).join("")}
    </div></section>
  </div>`;
}
function behavior(){
  const ms=activeMonths();
  const filteredLaunch=DATA.launches.filter(x=>(state.period==="ANO"||x.month===state.period)&&(state.category==="TODAS"||x.category===state.category));
  const vals=filteredLaunch.map(x=>x.value), total=vals.reduce((a,b)=>a+b,0), count=vals.length, ticket=count?total/count:0;
  const top=[...filteredLaunch].sort((a,b)=>b.value-a.value).slice(0,10);
  const days={};filteredLaunch.forEach(x=>{if(x.date){let d=new Date(x.date+"T12:00:00");let k=["Dom","Seg","Ter","Qua","Qui","Sex","Sáb"][d.getDay()];days[k]=(days[k]||0)+x.value;}});
  const periods={"1–7":0,"8–14":0,"15–21":0,"22–fim":0};filteredLaunch.forEach(x=>{if(x.date){let d=new Date(x.date+"T12:00:00").getDate();periods[d<=7?"1–7":d<=14?"8–14":d<=21?"15–21":"22–fim"]+=x.value;}});
  const hasDates=filteredLaunch.some(x=>x.date);
  const avgMonth=ms.length?total/ms.length:0;
  return `<div class="grid-kpi">
    ${kpi("Total de lançamentos",n(count),"Lançamentos filtrados")}
    ${kpi("Ticket médio",money(ticket),"Gasto médio por lançamento")}
    ${kpi("Maior lançamento",money(vals.length?Math.max(...vals):0),"Maior despesa registrada")}
    ${kpi("Média mensal",money(avgMonth),"Total de lançamentos ÷ períodos")}
    ${kpi("Top 2 categorias",pct(concentration(ms)),"Concentração dos gastos")}
    ${kpi("Dados com data",hasDates? "Sim":"Não","Necessário para análises temporais")}
  </div>
  <div class="grid">
    <section class="card span7"><h2>Top 10 maiores gastos</h2><div class="desc">Ordenação por valor dos lançamentos individuais.</div>
      ${top.length?`<table><thead><tr><th>Descrição</th><th>Categoria</th><th>Mês</th><th>Valor</th></tr></thead><tbody>${top.map(x=>`<tr><td>${esc(x.description)}</td><td>${esc(x.category)}</td><td>${x.month}</td><td>${money(x.value)}</td></tr>`).join("")}</tbody></table>`:`<div class="empty">Nenhum lançamento encontrado.</div>`}
    </section>
    <section class="card span5"><h2>Concentração por categoria</h2><div class="desc">Quanto das despesas está concentrado nas categorias líderes.</div>
      <div class="barlist">${cats.map(c=>{let v=filteredLaunch.filter(x=>x.category===c).reduce((a,b)=>a+b.value,0);return `<div class="barrow"><span>${esc(c)}</span><div class="track"><div class="fill" style="width:${total?v/total*100:0}%"></div></div><strong>${pct(total?v/total*100:0)}</strong></div>`}).join("")}</div>
    </section>
    <section class="card span6"><h2>Gastos por dia da semana</h2><div class="desc">${hasDates?"Distribuição dos lançamentos por dia da semana.":"A base atual não possui datas preenchidas nos lançamentos."}</div>${hasDates?barChart(Object.keys(days),Object.values(days),"Gastos por dia da semana"): '<div class="empty">Preencha as datas dos lançamentos para ativar esta análise.</div>'}</section>
    <section class="card span6"><h2>Gastos por período do mês</h2><div class="desc">${hasDates?"Concentração dos gastos dentro do mês.":"A base atual não possui datas preenchidas nos lançamentos."}</div>${hasDates?barChart(Object.keys(periods),Object.values(periods),"Gastos por período do mês"):'<div class="empty">Preencha as datas dos lançamentos para ativar esta análise.</div>'}</section>
  </div>`;
}
function annual(){
  const ms=activeMonths(), labels=ms;
  const rev=ms.map(m=>monthObj(m).revenue), real=ms.map(m=>catVal(monthObj(m),"actual",state.category)), plan=ms.map(m=>catVal(monthObj(m),"planned",state.category));
  const growth=ms.map((m,i)=>i? (monthObj(m).revenue-(monthObj(ms[i-1]).revenue||0)) : 0);
  const fixed=ms.map(m=>monthObj(m).actual["Gastos Fixos"]), leisure=ms.map(m=>monthObj(m).actual["Lazer"]), invest=ms.map(m=>monthObj(m).actual["Investimentos"]);
  const heat= `<div class="heat"><div class="head"></div>${months.map(m=>`<div class="head">${m}</div>`).join("")}${cats.map(c=>{let vals=months.map(m=>monthObj(m).actual[c]);let mx=Math.max(...vals,1);return `<div class="label">${esc(c)}</div>`+vals.map(v=>`<div class="cell" style="background:rgba(201,162,39,${Math.min(.75,v/mx*.75+.03)})">${money(v)}</div>`).join("")}).join("")}</div>`;
  const revGrowth=rev.length>1&&rev[0]?((rev[rev.length-1]/rev[0]-1)*100):0;
  const expGrowth=real.length>1&&real[0]?((real[real.length-1]/real[0]-1)*100):0;
  return `<div class="grid-kpi">
    ${kpi("Receita acumulada",money(rev.reduce((a,b)=>a+b,0)),"Período selecionado")}
    ${kpi("Gastos acumulados",money(real.reduce((a,b)=>a+b,0)),"Realizados")}
    ${kpi("Saldo acumulado",money(rev.reduce((a,b)=>a+b,0)-real.reduce((a,b)=>a+b,0)),"Receita menos gastos")}
    ${kpi("Crescimento da receita",pct(revGrowth),"Primeiro × último mês com base")}
    ${kpi("Taxa de investimento",pct(rev.reduce((a,b)=>a+b,0)?invest.reduce((a,b)=>a+b,0)/rev.reduce((a,b)=>a+b,0)*100:0),"Investimentos ÷ receita")}
    ${kpi("Concentração top 2",pct(concentration(ms)),"Duas maiores categorias")}
  </div>
  <div class="grid">
    <section class="card span8"><h2>Evolução anual</h2><div class="desc">Receita e gastos ao longo dos meses.</div><div class="chart">${lineChart([{label:"Receita",values:rev},{label:"Gastos",values:real}],labels,"Evolução anual")}</div></section>
    <section class="card span4"><h2>Receita × gasto — crescimento</h2><div class="desc">Comparação do primeiro e último ponto com dados.</div>${barChart(["Receita","Gastos"],[rev[0]||0,real[0]||0],"Primeiro mês",[rev[rev.length-1]||0,real[real.length-1]||0])}</section>
    <section class="card span12"><h2>Heatmap de gastos por categoria</h2><div class="desc">Identifique rapidamente meses fora do padrão. Intensidade maior = maior gasto relativo dentro da categoria.</div>${heat}</section>
    <section class="card span4"><h2>Gastos Fixos</h2><div class="desc">Comprometimento estrutural da renda.</div>${lineChart([{label:"Gastos Fixos",values:fixed}],labels,"Gastos fixos")}</section>
    <section class="card span4"><h2>Lazer</h2><div class="desc">Acompanhamento do padrão de lazer.</div>${lineChart([{label:"Lazer",values:leisure}],labels,"Lazer")}</section>
    <section class="card span4"><h2>Investimentos</h2><div class="desc">Meta comportamental de construção patrimonial.</div>${lineChart([{label:"Investimentos",values:invest}],labels,"Investimentos")}</section>
    <section class="card span12"><h2>Planejamento × execução</h2><div class="desc">Desvio acumulado da seleção atual.</div><table><thead><tr><th>Mês</th><th>Receita</th><th>Planejado</th><th>Realizado</th><th>Desvio</th><th>% consumido</th></tr></thead><tbody>${ms.map((m,i)=>`<tr><td>${m}</td><td>${money(rev[i])}</td><td>${money(plan[i])}</td><td>${money(real[i])}</td><td>${money(real[i]-plan[i])}</td><td>${plan[i]?pct(real[i]/plan[i]*100):"—"}</td></tr>`).join("")}</tbody></table></section>
  </div>`;
}
function render(){
  const app=$("app");
  app.innerHTML=state.tab==="overview"?overview():state.tab==="behavior"?behavior():annual();
}
function init(){
  months.forEach(m=>$("period").insertAdjacentHTML("beforeend",`<option value="${m}">${m}</option>`));
  cats.forEach(c=>$("category").insertAdjacentHTML("beforeend",`<option value="${esc(c)}">${esc(c)}</option>`));
  $("period").addEventListener("change",e=>{state.period=e.target.value;render()});
  $("category").addEventListener("change",e=>{state.category=e.target.value;render()});
  $("mode").addEventListener("change",e=>{state.mode=e.target.value;render()});
  $("hideEmpty").addEventListener("change",e=>{state.hideEmpty=e.target.checked;render()});
  document.querySelectorAll(".tab").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));b.classList.add("active");state.tab=b.dataset.tab;render()}));
  $("reset").addEventListener("click",()=>{$("period").value="ANO";$("category").value="TODAS";$("mode").value="REALIZADO";$("hideEmpty").checked=false;state.period="ANO";state.category="TODAS";state.mode="REALIZADO";state.hideEmpty=false;render()});
  $("print").addEventListener("click",()=>window.print());
  render();
}

async function loadUserData(){
  const {data:{user},error:e1}=await sb.auth.getUser(); if(e1) throw e1;
  if(!user) return;
  const {data:plans,error:e2}=await sb.from("monthly_plans").select("*").eq("user_id",user.id).order("year").order("month");
  if(e2) throw e2;
  const {data:txs,error:e3}=await sb.from("transactions").select("*").eq("user_id",user.id).order("transaction_date");
  if(e3) throw e3;
  const names=["JAN","FEV","MAR","ABR","MAI","JUN","JUL","AGO","SET","OUT","NOV","DEZ"];
  DATA.months=(plans||[]).map(p=>({
    month:names[p.month-1],year:p.year,revenue:+(p.revenue||0),
    planned:{"Gastos Fixos":+(p.fixed_expenses||0),"Investimentos":+(p.investments||0),"Conforto":+(p.comfort||0),"Metas":+(p.goals||0),"Lazer":+(p.leisure||0),"Conhecimento":+(p.knowledge||0)},
    actual:{"Gastos Fixos":0,"Investimentos":0,"Conforto":0,"Metas":0,"Lazer":0,"Conhecimento":0}
  }));
  DATA.launches=(txs||[]).map(t=>{const d=t.transaction_date?new Date(t.transaction_date+"T12:00:00"):null;return{month:d?names[d.getMonth()]:"",category:t.category,date:t.transaction_date||"",description:t.description||"Sem descrição",value:+(t.amount||0)}});
  DATA.launches.forEach(t=>{const m=DATA.months.find(x=>x.month===t.month);if(m&&m.actual[t.category]!==undefined)m.actual[t.category]+=t.value;});
}
function showDashboard(user){$("authScreen").classList.add("hidden");$("dashboardRoot").classList.remove("hidden");$("userEmail").textContent=user.email||"";init();}
function msg(t,ok=false){$("authMsg").textContent=t;$("authMsg").className="auth-msg"+(ok?" ok":" err");}
$("authForm").addEventListener("submit",async e=>{e.preventDefault();msg("Entrando...",true);const{data,error}=await sb.auth.signInWithPassword({email:$("email").value.trim(),password:$("password").value});if(error)return msg(error.message);await loadUserData();showDashboard(data.user);});
$("signupBtn").addEventListener("click",async()=>{const email=$("email").value.trim(),password=$("password").value;if(!email||!password)return msg("Preencha e-mail e senha.");msg("Criando conta...",true);const{data,error}=await sb.auth.signUp({email,password});if(error)return msg(error.message);if(!data.session)msg("Conta criada. Confirme seu e-mail para entrar.",true);else{await loadUserData();showDashboard(data.user);}});
$("resetBtn").addEventListener("click",async()=>{const email=$("email").value.trim();if(!email)return msg("Digite seu e-mail.");const{error}=await sb.auth.resetPasswordForEmail(email,{redirectTo:location.origin+location.pathname});if(error)return msg(error.message);msg("Link de recuperação enviado.",true);});
$("logout").addEventListener("click",async()=>{await sb.auth.signOut();location.reload();});
(async()=>{if(SUPABASE_ANON_KEY.includes("COLE_AQUI")){msg("Configure a chave pública do Supabase no arquivo.");return;}const{data:{session}}=await sb.auth.getSession();if(session){try{await loadUserData();showDashboard(session.user);}catch(e){msg(e.message);}}})();

</script>
